
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberreserve
DB_USER=postgres
DB_PASSWORD=tu_password

JWT_SECRET=tu_clave_secreta

# Zona horaria de la barbería (Barber Reserve 2.0). Se usa para no permitir
# reservas en horarios pasados y para calcular "hoy" en el dashboard.
APP_TIMEZONE=America/Bogota

# --- Solo en la nube (Render, Neon, etc.) ---
# Si existe DATABASE_URL se usa en lugar de DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgres://usuario:clave@host:5432/basedatos
# DB_SSL=true                  # necesario con la URL externa de Render o con Neon
# CORS_ORIGIN=https://barberreserve-diego.onrender.com   # dominios del frontend, separados por coma
# TRUST_PROXY=true             # detrás del proxy del hosting, para que el límite de solicitudes vea la IP real
