# Variables usadas por docker-compose.yml. Copia este archivo a ".env"
# (en esta misma carpeta, la raíz del proyecto) y reemplaza los valores
# antes de ejecutar "docker compose up".
#
# Nota: este .env es distinto de backend/.env — ese otro solo se usa para
# correr el backend en tu máquina SIN Docker.

# Base de datos PostgreSQL
DB_NAME=barberreserve
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena

# Firma de los tokens de sesión (JWT). Usa una cadena larga y aleatoria.
JWT_SECRET=cambia_esta_clave_secreta

# URL que el NAVEGADOR usará para llegar al backend. Se incrusta en el
# frontend al momento de construir su imagen (no se puede cambiar después
# sin reconstruirla). Debe apuntar al puerto del backend publicado en el
# host — por defecto 4000, igual que en desarrollo local.
VITE_API_URL=http://localhost:4000/api

# Zona horaria de la barbería (Barber Reserve 2.0). Se usa para no permitir
# reservas en horarios pasados y para calcular "hoy" en el dashboard.
APP_TIMEZONE=America/Bogota
